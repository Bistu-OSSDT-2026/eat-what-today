<view class="home-page" style="padding-top: {{topInset}}px;">
  <view class="topbar">
    <view class="brand-block" bindlongpress="openAdmin" aria-role="button" aria-label="长按进入管理员登录">
      <text class="brand-kicker">BISTU CAMPUS DINING</text>
      <text class="brand-title">今天吃什么</text>
    </view>
    <button class="profile-button" bindtap="openProfile" aria-label="打开个人资料">
      <view class="profile-mark"></view>
      <text class="profile-label">{{profileLabel}}</text>
    </button>
  </view>

  <view class="status-row">
    <text>{{editionDate}}</text>
    <text class="status-note {{loading ? 'is-loading' : ''}}">{{networkNote}}</text>
  </view>

  <view class="content">
    <view class="announcement" wx:if="{{announcementText}}">
      <text class="announcement-label">今日公告</text>
      <text class="announcement-text">{{announcementText}}</text>
    </view>

    <view class="decision-card {{randomRolling ? 'is-rolling' : ''}}">
      <view class="decision-copy">
        <text class="decision-kicker">现在就决定</text>
        <text class="decision-title">{{randomPick.shop}}</text>
        <text class="decision-place">{{randomPick.place}}</text>
      </view>
      <button class="decision-button" bindtap="rollRandomPick">换一个</button>
    </view>

    <view class="quick-actions">
      <button class="action-button is-primary" bindtap="openSubmitSheet">推荐菜品</button>
      <button class="action-button" loading="{{loading}}" disabled="{{loading}}" bindtap="refreshData">刷新榜单</button>
    </view>

    <view class="section">
      <view class="section-heading">
        <view>
          <text class="section-title">今日首选</text>
          <text class="section-subtitle">榜单第一名</text>
        </view>
        <text class="section-score">{{leadDish.scoreText}} 分</text>
      </view>

      <view class="feature">
        <image class="feature-image" src="{{leadDish.imageUrl}}" mode="aspectFill" binderror="onLeadDishImageError"></image>
        <view class="feature-copy">
          <text class="feature-category">{{leadDish.categoryName}}</text>
          <text class="feature-title">{{leadDish.name}}</text>
          <text class="feature-description">{{leadDish.description}}</text>
          <text class="feature-place">{{leadDish.placeText}}</text>
          <view class="feature-meta">
            <text>{{leadDish.ratingText}}</text>
            <view class="rating-strip" wx:if="{{leadDish.canRate}}">
              <button
                wx:for="{{ratingScoreOptions}}"
                wx:for-item="score"
                wx:key="*this"
                class="rating-button"
                data-dish-id="{{leadDish.id}}"
                data-score="{{score}}"
                bindtap="onRateTap"
                aria-label="给这道菜打 {{score}} 分"
              >{{score}}</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section ranking-section">
      <view class="section-heading">
        <view>
          <text class="section-title">风味榜</text>
          <text class="section-subtitle">来自同学的真实评分</text>
        </view>
        <text class="section-count">{{rankingRows.length}} 道</text>
      </view>

      <view class="ranking-list">
        <view class="ranking-row" wx:for="{{rankingRows}}" wx:key="id">
          <text class="rank-number">{{index + 1}}</text>
          <view class="rank-copy">
            <view class="rank-title-row">
              <text class="rank-title">{{item.name}}</text>
              <text class="rank-category">{{item.categoryName}}</text>
            </view>
            <text class="rank-place">{{item.placeText}}</text>
            <view class="rating-strip compact" wx:if="{{item.canRate}}">
              <button
                wx:for="{{ratingScoreOptions}}"
                wx:for-item="score"
                wx:key="*this"
                class="rating-button"
                data-dish-id="{{item.id}}"
                data-score="{{score}}"
                bindtap="onRateTap"
                aria-label="给 {{item.name}} 打 {{score}} 分"
              >{{score}}</button>
            </view>
          </view>
          <view class="rank-score">
            <text class="rank-score-value">{{item.scoreText}}</text>
            <text class="rank-score-label">{{item.ratingText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{categoryRows.length}}">
      <view class="section-heading">
        <view>
          <text class="section-title">想吃哪一类</text>
          <text class="section-subtitle">今日收录分类</text>
        </view>
      </view>
      <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="category-list">
          <text class="category-chip" wx:for="{{categoryRows}}" wx:key="id">{{item.name}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="footer">
      <text>数据来自校园同学投稿</text>
      <text wx:if="{{isAdmin}}" class="footer-link" bindtap="openAdmin">管理后台</text>
    </view>
  </view>

  <view class="submit-mask {{submitSheetClosing ? 'is-closing' : ''}}" wx:if="{{showSubmitSheet}}" bindtap="closeSubmitSheet"></view>
  <scroll-view class="submit-sheet {{submitSheetClosing ? 'is-closing' : ''}}" wx:if="{{showSubmitSheet}}" scroll-y show-scrollbar="{{false}}">
    <view class="sheet-header">
      <view>
        <text class="sheet-kicker">推荐一道菜</text>
        <text class="sheet-title">让更多同学吃到</text>
      </view>
      <button class="sheet-close" bindtap="closeSubmitSheet" aria-label="关闭投稿表单">
        <image class="ui-button-icon" src="/images/icons/close.svg" mode="aspectFit"></image>
      </button>
    </view>

    <view class="field">
      <text class="field-label">菜品名称</text>
      <input model:value="{{form.name}}" placeholder="例如 黄焖鸡米饭" maxlength="40" always-embed="{{true}}" />
    </view>

    <view class="field-grid">
      <view class="field">
        <text class="field-label">分类</text>
        <input model:value="{{form.categoryName}}" placeholder="盖饭 / 粉面" maxlength="20" always-embed="{{true}}" />
      </view>
      <view class="field">
        <text class="field-label">楼层</text>
        <input model:value="{{form.floorName}}" placeholder="一楼" maxlength="20" always-embed="{{true}}" />
      </view>
    </view>

    <view class="field">
      <text class="field-label">店铺或窗口</text>
      <input model:value="{{form.shopName}}" placeholder="窗口名称" maxlength="40" always-embed="{{true}}" />
    </view>

    <view class="field">
      <text class="field-label">一句描述</text>
      <textarea
        model:value="{{form.description}}"
        placeholder="口味、份量、适合什么时候吃"
        maxlength="160"
        show-confirm-bar="{{false}}"
        fixed="{{true}}"
        disable-default-padding="{{true}}"
      />
    </view>

    <button class="image-picker" bindtap="chooseImage">
      <image wx:if="{{imagePath}}" class="image-preview" src="{{imagePath}}" mode="aspectFill"></image>
      <view wx:else class="image-empty">
        <text class="image-empty-title">选择图片</text>
        <text class="image-empty-note">单图不超过 5MB</text>
      </view>
    </button>

    <view class="image-meta" wx:if="{{imageName}}">
      <text class="image-name">{{imageName}}</text>
      <button class="image-remove" bindtap="clearImage">移除</button>
    </view>

    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitDish">提交推荐</button>
  </scroll-view>
</view>
