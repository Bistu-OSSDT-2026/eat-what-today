<view class="ui-page admin-page" style="padding-top: {{topInset}}px;">
  <view class="ui-topbar">
    <button class="ui-icon-button" bindtap="goBack" aria-label="返回上一页">
      <image class="ui-button-icon" src="/images/icons/back.svg" mode="aspectFit"></image>
    </button>
    <view class="ui-page-heading">
      <text class="ui-page-title">管理后台</text>
      <text class="ui-page-subtitle">{{schoolName}}</text>
    </view>
    <view></view>
  </view>

  <view class="login-wrap" wx:if="{{!adminToken}}">
    <view class="ui-card login-panel">
      <text class="panel-kicker">ADMIN ACCESS</text>
      <text class="login-title">管理员登录</text>
      <text class="login-copy">登录后可以维护公告、分类和菜品上下架。</text>
      <view class="ui-field login-field">
        <text class="ui-field-label">管理密码</text>
        <input password value="{{password}}" bindinput="onPasswordInput" placeholder="请输入管理密码" />
      </view>
      <button
        class="ui-primary-button"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="loginAdmin"
      >进入管理后台</button>
    </view>
  </view>

  <block wx:else>
    <view class="admin-toolbar">
      <view class="toolbar-copy">
        <text class="toolbar-title">食堂内容管理</text>
        <text class="toolbar-subtitle">公告、分类、审核与上下架</text>
      </view>
      <view class="toolbar-actions">
        <button class="toolbar-button" loading="{{loading}}" disabled="{{loading}}" bindtap="loadAdminData">刷新</button>
        <button class="toolbar-button is-danger" bindtap="logoutAdmin">退出</button>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stat-card is-yellow">
        <text class="stat-value">{{stats.total}}</text>
        <text class="stat-label">全部菜品</text>
      </view>
      <view class="stat-card is-green">
        <text class="stat-value">{{stats.active}}</text>
        <text class="stat-label">上架中</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{stats.offline}}</text>
        <text class="stat-label">已下架</text>
      </view>
      <view class="stat-card is-red">
        <text class="stat-value">{{stats.pending}}</text>
        <text class="stat-label">待审核</text>
      </view>
    </view>

    <view class="admin-section">
      <view class="ui-section-head">
        <text class="ui-section-title">公告管理</text>
        <text class="ui-section-subtitle">首页公告</text>
      </view>
      <view class="ui-field">
        <text class="ui-field-label">公告内容</text>
        <textarea value="{{announcement}}" bindinput="onAnnouncementInput" maxlength="160" placeholder="输入首页要显示的短讯" show-confirm-bar="{{false}}" />
      </view>
      <button class="ui-primary-button section-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveAnnouncement">保存公告</button>
    </view>

    <view class="admin-section">
      <view class="ui-section-head">
        <text class="ui-section-title">分类管理</text>
        <text class="ui-section-subtitle">{{categories.length}} 个分类</text>
      </view>
      <view class="category-list">
        <text wx:for="{{categories}}" wx:key="id" class="category-chip">{{item.name}}</text>
        <text wx:if="{{categories.length === 0}}" class="category-empty">暂无分类</text>
      </view>
      <view class="inline-form">
        <input value="{{categoryName}}" bindinput="onCategoryInput" placeholder="例如 粉面、盖饭" maxlength="24" />
        <button bindtap="addCategory">添加</button>
      </view>
    </view>

    <view class="admin-section dish-section">
      <view class="ui-section-head">
        <text class="ui-section-title">菜品管理</text>
        <text class="ui-section-subtitle">{{visibleDishes.length}} 条结果</text>
      </view>

      <scroll-view scroll-x class="status-scroll" enhanced show-scrollbar="{{false}}">
        <view class="status-tabs">
          <button
            wx:for="{{statusTabs}}"
            wx:key="key"
            class="status-tab {{activeStatus === item.key ? 'active' : ''}}"
            data-status="{{item.key}}"
            bindtap="switchStatus"
          >{{item.label}}</button>
        </view>
      </scroll-view>

      <view class="dish-admin-list">
        <view class="dish-admin-row status-{{dish.statusClass}}" wx:for="{{visibleDishes}}" wx:for-item="dish" wx:key="id">
          <image
            class="dish-thumb"
            src="{{dish.displayImageUrl}}"
            mode="aspectFit"
            lazy-load="{{true}}"
            data-id="{{dish.id}}"
            binderror="onDishImageError"
          ></image>
          <view class="dish-body">
            <view class="row-top">
              <text class="status-badge">{{dish.statusText}}</text>
              <text class="score">{{dish.scoreText}} 分</text>
            </view>
            <text class="dish-name">{{dish.name}}</text>
            <text class="dish-place">{{dish.placeText}}</text>
            <text class="dish-meta">{{dish.ratingText}}</text>
            <view class="row-actions">
              <button bindtap="openEditSheet" data-id="{{dish.id}}">编辑</button>
              <button
                wx:if="{{dish.status !== 'ACTIVE'}}"
                class="is-primary"
                bindtap="updateDishStatus"
                data-id="{{dish.id}}"
                data-status="ACTIVE"
              >上架</button>
              <button
                wx:else
                class="is-danger"
                bindtap="updateDishStatus"
                data-id="{{dish.id}}"
                data-status="OFFLINE"
              >下架</button>
            </view>
          </view>
        </view>

        <view class="empty" wx:if="{{!loading && visibleDishes.length === 0}}">
          当前筛选下没有菜品
        </view>
      </view>
    </view>
  </block>

  <view class="ui-sheet-mask {{editSheetClosing ? 'is-closing' : ''}}" wx:if="{{showEditSheet}}" bindtap="closeEditSheet"></view>
  <scroll-view class="ui-sheet edit-sheet {{editSheetClosing ? 'is-closing' : ''}}" wx:if="{{showEditSheet}}" scroll-y show-scrollbar="{{false}}">
    <view class="sheet-head">
      <view>
        <text class="panel-kicker">EDIT DISH</text>
        <text class="sheet-title">编辑菜品</text>
      </view>
      <button class="ui-icon-button" bindtap="closeEditSheet" aria-label="关闭编辑表单">
        <image class="ui-button-icon" src="/images/icons/close.svg" mode="aspectFit"></image>
      </button>
    </view>

    <view class="ui-field">
      <text class="ui-field-label">菜品名称</text>
      <input value="{{editForm.name}}" data-field="name" bindinput="onEditInput" maxlength="40" always-embed="{{true}}" />
    </view>
    <view class="field-grid">
      <view class="ui-field">
        <text class="ui-field-label">分类</text>
        <input value="{{editForm.categoryName}}" data-field="categoryName" bindinput="onEditInput" maxlength="24" always-embed="{{true}}" />
      </view>
      <view class="ui-field">
        <text class="ui-field-label">楼层</text>
        <input value="{{editForm.floorName}}" data-field="floorName" bindinput="onEditInput" maxlength="24" always-embed="{{true}}" />
      </view>
    </view>
    <view class="ui-field">
      <text class="ui-field-label">窗口</text>
      <input value="{{editForm.shopName}}" data-field="shopName" bindinput="onEditInput" maxlength="40" always-embed="{{true}}" />
    </view>
    <view class="ui-field">
      <text class="ui-field-label">图片地址</text>
      <input value="{{editForm.imageUrl}}" data-field="imageUrl" bindinput="onEditInput" placeholder="没有图片可留空" always-embed="{{true}}" />
    </view>
    <view class="ui-field">
      <text class="ui-field-label">描述</text>
      <textarea
        value="{{editForm.description}}"
        data-field="description"
        bindinput="onEditInput"
        maxlength="160"
        show-confirm-bar="{{false}}"
        fixed="{{true}}"
        disable-default-padding="{{true}}"
      />
    </view>

    <button class="ui-primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveDishEdit">保存菜品</button>
  </scroll-view>
</view>
