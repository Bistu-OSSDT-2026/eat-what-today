<view class="ui-page profile-page" style="padding-top: {{readerTop}}px;">
  <view class="ui-topbar">
    <button class="ui-icon-button" bindtap="goBack" aria-label="返回上一页">
      <image class="ui-button-icon" src="/images/icons/back.svg" mode="aspectFit"></image>
    </button>
    <view class="ui-page-heading">
      <text class="ui-page-title">个人资料</text>
      <text class="ui-page-subtitle">投稿和评分使用的公开身份</text>
    </view>
    <view></view>
  </view>

  <view class="ui-card profile-hero">
    <button
      class="avatar-button"
      open-type="chooseAvatar"
      bindtap="__hapticTap"
      bindchooseavatar="onChooseAvatar"
      aria-label="选择头像"
    >
      <image
        wx:if="{{form.avatarUrl}}"
        class="avatar-image"
        src="{{form.avatarUrl}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="avatar-placeholder">
        <text class="avatar-placeholder-title">选择头像</text>
        <text class="avatar-placeholder-note">点击更换</text>
      </view>
    </button>

    <view class="profile-copy">
      <text class="profile-status {{registered ? 'is-active' : ''}}">{{statusLabel}}</text>
      <text class="profile-name">{{form.nickname || '微信读者'}}</text>
      <text class="profile-description">{{identityLabel}}</text>
    </view>
  </view>

  <view class="identity-grid">
    <view class="identity-item">
      <text class="identity-value">{{registered ? '已开启' : '待设置'}}</text>
      <text class="identity-label">投稿身份</text>
    </view>
    <view class="identity-item">
      <text class="identity-value">{{registered ? '已开启' : '待设置'}}</text>
      <text class="identity-label">评分身份</text>
    </view>
    <view class="identity-item">
      <text class="identity-value">最少信息</text>
      <text class="identity-label">隐私范围</text>
    </view>
  </view>

  <view class="profile-form">
    <view class="ui-section-head">
      <text class="ui-section-title">资料设置</text>
      <text class="ui-section-subtitle">头像与昵称</text>
    </view>

    <view class="ui-field">
      <text class="ui-field-label">昵称</text>
      <input
        model:value="{{form.nickname}}"
        type="nickname"
        placeholder="微信昵称或常用名"
        maxlength="20"
      />
    </view>

    <button
      class="ui-primary-button"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submit"
    >{{registered ? '保存个人资料' : '保存并登录'}}</button>

    <button
      wx:if="{{registered}}"
      class="ui-danger-button logout-button"
      bindtap="logoutUser"
    >退出当前身份</button>
  </view>

  <view class="privacy-note">
    <text class="privacy-title">隐私说明</text>
    <text>只保存用于展示的头像和昵称，不读取手机号、位置或通讯录。</text>
  </view>
</view>
